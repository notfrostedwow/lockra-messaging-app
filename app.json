{
  "expo": {
    "name": "lockra",
    "slug": "lockra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockra",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "57.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.lockra",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "UIStatusBarStyle": "UIStatusBarStyleDefault"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.example.lockra"
    }
  }
}

# npm start/build:web always use offline demo and do not autoload this file.
EXPO_PUBLIC_LOCKRA_MODE=demo
# Deliberate future integration only; provision your OWN isolated environment.
EXPO_PUBLIC_ENABLE_INTEGRATIONS=false
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
# Never put LogSnag, service-role, Clerk secret, billing, or provider secrets here.
# Optional future calling CLIENT configuration; defaults remain disabled.
EXPO_PUBLIC_ENABLE_CALLS=false
EXPO_PUBLIC_CALL_API_URL=https://example.invalid
EXPO_PUBLIC_LIVEKIT_URL=wss://example.invalid
# Server-only variables are described in docs/CALLING.md; never prefix secrets EXPO_PUBLIC.
